{
  "name": "marty-supreme",
  "displayName": "Marty Supreme",
  "description": "Relive your Marty Supreme moment as you wait for your CLI prompt with some exclusive motivation ;)",
  "version": "0.0.1",
  "publisher": "marty-supreme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Fun"
  ],
  "keywords": [
    "motivation",
    "games",
    "productivity",
    "hackathon"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:marty-supreme.runPong",
    "onCommand:marty-supreme.startAutoMonitor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "marty-supreme.hello",
        "title": "Marty Supreme: Hello World"
      },
      {
        "command": "marty-supreme.runExampleGame",
        "title": "Marty Supreme: Run Example Game"
      },
      {
        "command": "marty-supreme.runTetris",
        "title": "Marty Supreme: Run Tetris 1926"
      },
      {
        "command": "marty-supreme.runBlackjack",
        "title": "Marty Supreme: Run Blackjack 1940s"
      },
      {
        "command": "marty-supreme.runPong",
        "title": "Marty Supreme: Run Pong 1950 (Hand Tracking)"
      },
      {
        "command": "marty-supreme.stopPong",
        "title": "Marty Supreme: Stop Pong"
      },
      {
        "command": "marty-supreme.configureMonitorRegion",
        "title": "Marty Supreme: Configure Agent Monitor Region"
      },
      {
        "command": "marty-supreme.configureMonitorRegionInteractive",
        "title": "Marty Supreme: Draw Agent Monitor Region On Screen"
      },
      {
        "command": "marty-supreme.configureMonitorIcons",
        "title": "Marty Supreme: Configure Agent Monitor Icons"
      },
      {
        "command": "marty-supreme.configureMonitorAdvanced",
        "title": "Marty Supreme: Configure Agent Monitor Advanced"
      },
      {
        "command": "marty-supreme.startAutoMonitor",
        "title": "Marty Supreme: Start Agent Icon Monitor"
      },
      {
        "command": "marty-supreme.stopAutoMonitor",
        "title": "Marty Supreme: Stop Agent Icon Monitor"
      },
      {
        "command": "marty-supreme.captureMonitorSnippet",
        "title": "Marty Supreme: Capture Monitor Detection Snippet (5s)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc --noEmit && node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "esbuild": "^0.20.0"
  }
}
