{
  "name": "marty-supreme",
  "displayName": "Marty Supreme",
  "description": "Relive your Marty Supreme moment as you wait for your CLI prompt with some exclusive motivation ;)",
  "version": "0.0.1",
  "publisher": "marty-supreme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Fun"
  ],
  "keywords": [
    "motivation",
    "games",
    "productivity",
    "hackathon"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:marty-supreme.runPong",
    "onChatParticipant:marty.agent"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "marty.agent",
        "name": "marty",
        "fullName": "Marty Supreme Agent",
        "description": "Launches Marty Pong while you think",
        "isSticky": true
      }
    ],
    "commands": [
      {
        "command": "marty-supreme.hello",
        "title": "Marty Supreme: Hello World"
      },
      {
        "command": "marty-supreme.runExampleGame",
        "title": "Marty Supreme: Run Example Game"
      },
      {
        "command": "marty-supreme.runTetris",
        "title": "Marty Supreme: Run Tetris 1926"
      },
      {
        "command": "marty-supreme.runBlackjack",
        "title": "Marty Supreme: Run Blackjack 1940s"
      },
      {
        "command": "marty-supreme.runPong",
        "title": "Marty Supreme: Run Pong 1950 (Hand Tracking)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc --noEmit && node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "mcp:build": "npm --prefix mcp run build",
    "mcp:dev": "npm --prefix mcp run dev",
    "mcp:start": "npm --prefix mcp run start",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "esbuild": "^0.20.0"
  }
}
